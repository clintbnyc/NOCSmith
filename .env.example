# Variable names for the 1Password Environment mounted as .env.
# Add the real values in 1Password; do not copy resolved secrets into this file.
UNIFI_API_KEY=replace-in-1password
UNIFI_BASE_URL=https://unifi.nutria-newton.ts.net/proxy/network/integration
# Optional read-only Site Manager v1 API key generated at unifi.ui.com.
# UNIFI_SITE_API_KEY=replace-in-1password
# Required only for deterministic Site Manager enrichment of this local controller.
# UNIFI_SITE_MANAGER_LOCAL_HOST_ID=
# UNIFI_DEFAULT_SITE_ID=
# UNIFI_TIMEOUT_SECONDS=30
# Enables fixed device/client enrichment, bounded client history, client-group reads, and the read-only System Logs query.
UNIFI_ENABLE_LEGACY_READ_ENRICHMENT=false
