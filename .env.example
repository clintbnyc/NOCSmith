# Variable names for the 1Password Environment mounted as .env.
# Add the real values in 1Password; do not copy resolved secrets into this file.
UNIFI_API_KEY=replace-in-1password
UNIFI_BASE_URL=https://unifi.nutria-newton.ts.net/proxy/network/integration
# Optional read-only Site Manager v1 API key generated at unifi.ui.com.
# UNIFI_SITE_API_KEY=replace-in-1password
# Required only for deterministic Site Manager enrichment of this local controller.
# UNIFI_SITE_MANAGER_LOCAL_HOST_ID=
# UNIFI_DEFAULT_SITE_ID=
# UNIFI_TIMEOUT_SECONDS=30
# Enables fixed device/client enrichment, bounded client history, client-group reads, and the read-only System Logs query.
UNIFI_ENABLE_LEGACY_READ_ENRICHMENT=false
# Optional explicit-only projected client observation journal. Enabling requires
# the private-read gate above only for collection; health and queries need only
# this gate and the absolute path.
UNIFI_ENABLE_CLIENT_JOURNAL=false
# UNIFI_CLIENT_JOURNAL_DB_PATH=/Users/cbeilman/Library/Application Support/unifi-mcp/client-journal.db
# UNIFI_CLIENT_JOURNAL_RETENTION_DAYS=90
# UNIFI_CLIENT_JOURNAL_MAX_MIB=256
# Optional unattended collection. Requires both gates above.
# UNIFI_ENABLE_SCHEDULED_COLLECTION=false
# UNIFI_SCHEDULED_COLLECTION_INTERVAL_MINUTES=60
# UNIFI_SCHEDULED_COLLECTION_SITE_ID=
# UNIFI_SCHEDULED_COLLECTION_HISTORY_HOURS=24
# Streamable HTTP server settings. Bearer is the portable default.
# UNIFI_MCP_HTTP_AUTH_MODE=bearer
# UNIFI_MCP_HTTP_BEARER_TOKEN=replace-in-1password
# UNIFI_MCP_TAILSCALE_ALLOWED_USERS=clint@example.com
# UNIFI_MCP_HTTP_PUBLIC_URL=https://unifi-mcp.example.com/mcp
# UNIFI_MCP_HTTP_LISTEN_URL=http://0.0.0.0:8080
# UNIFI_MCP_TAILSCALE_SOCKET_PATH=/absolute/private/directory/unifi-mcp.sock
