# Copy to .env.op and replace only the op:// reference below.
# The resolved secret is injected into the child process by `op run`.
# If more than one 1Password account is configured, pass --account before `run`.
UNIFI_API_KEY=op://YOUR_VAULT/YOUR_ITEM/YOUR_FIELD

UNIFI_BASE_URL=https://unifi.nutria-newton.ts.net/proxy/network/integration
# UNIFI_DEFAULT_SITE_ID=
UNIFI_ENABLE_LEGACY_READ_ENRICHMENT=false
